{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User authentication and authorization data",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ACAD_ADMIN", "EDU_MANAGER", "EMPLOYEE"] },
        "national_id": { "type": "string" },
        "work_unit_id": { "type": "number" },
        "governorate": { "type": "string" },
        "name": { "type": "string" },
        "is_staff": { "type": "boolean" },
        "is_active": { "type": "boolean" }
      },
      "required": ["email", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Primary employee record",
      "type": "object",
      "properties": {
        "national_id": { "type": "string" },
        "employee_code": { "type": "string" },
        "full_name_ar": { "type": "string" },
        "phone_number": { "type": "string" },
        "email": { "type": "string" },
        "job_title": { "type": "string" },
        "work_place_id": { "type": "number" },
        "governorate": { "type": "string" },
        "employee_type": { "type": "string", "enum": ["TEACHER", "ADMIN", "TRAINER", "TECHNICIAN"] },
        "employment_date": { "type": "string" }
      },
      "required": ["national_id", "full_name_ar", "email", "work_place_id", "employee_type"]
    },
    "WorkUnit": {
      "title": "Work Unit",
      "description": "A school, department, or directorate",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name_ar": { "type": "string" },
        "unit_type": { "type": "string", "enum": ["SCHOOL", "EDU_DEPT", "DIRECTORATE", "OTHER"] },
        "governorate": { "type": "string" },
        "manager_national_id": { "type": "string" }
      },
      "required": ["id", "name_ar", "unit_type", "governorate"]
    },
    "Appraisal": {
      "title": "Appraisal",
      "description": "Employee performance evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "managerId": { "type": "string" },
        "year": { "type": "number" },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Submitted", "Approved"] }
      },
      "required": ["id", "employeeId", "managerId", "year", "rating", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles by email"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Employee records by national ID"
    },
    "/work_units/{unitId}": {
      "schema": "WorkUnit",
      "description": "Work units"
    },
    "/appraisals/{appraisalId}": {
      "schema": "Appraisal",
      "description": "Performance evaluations"
    }
  }
}

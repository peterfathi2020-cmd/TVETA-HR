rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // HELPERS
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.uid in ["dL6527fx8fdiKXmVDPJVZ9UyCJg1", "cecjjnpTEeSxzv3BGpAnCkzgZlJ3", "0orr3a8eNwV4RSZz4IBEyxVSfPl2", "TBTTLtt9Tng0ct22gTtiDleYjWD2"] ||
        (request.auth.token.email in ["peterfathi2020@gmail.com", "admin.sys@academy.edu.eg", "tveta.hr.2026@gmail.com", "tveta2026@gmail.com"])
      );
    }

    function hasUserData() {
      return isSignedIn() && request.auth.token.email != null && exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return isMasterAdmin() || (hasUserData() && getUserData().get('role', '') == 'ACAD_ADMIN');
    }

    function isManager() {
      return isAdmin() || (hasUserData() && getUserData().get('role', '') == 'EDU_MANAGER');
    }

    function getUserGovernorate() {
       return hasUserData() ? getUserData().get('governorate', null) : null;
    }

    function isGovernorateManager(gov) {
      return isMasterAdmin() || (isManager() && getUserGovernorate() == gov);
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['national_id', 'full_name_ar', 'email', 'work_place_id', 'employee_type']) &&
             data.national_id is string && data.national_id.size() == 14 &&
             data.full_name_ar is string && data.full_name_ar.size() >= 3 &&
             data.email is string &&
             (data.work_place_id is int || data.work_place_id is float || data.work_place_id is number) &&
             data.employee_type in ['TEACHER', 'ADMIN', 'TRAINER', 'TECHNICIAN'];
    }

    // ===============================================================
    // RULES
    // ===============================================================

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin() || isManager());
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email == email) ||
        (isManager() && incoming().get('role', '') == 'EMPLOYEE')
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email == email && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'governorate']))
      );
    }

    // Employees collection
    match /employees/{employeeId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        isMasterAdmin() ||
        isAdmin() ||
        (request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email) ||
        (request.auth.token.email != null && resource.data.get('academic_email', '') == request.auth.token.email) ||
        isGovernorateManager(resource.data.get('governorate', null))
      );
      
      allow create: if isAdmin() || (
        isManager() && isValidEmployee(incoming()) && incoming().get('governorate', null) == getUserGovernorate()
      ) || (
        isSignedIn() &&
        incoming().get('email', '') == request.auth.token.email &&
        incoming().get('national_id', '') == employeeId
      );
      
      allow update: if isAdmin() || (
        isGovernorateManager(existing().get('governorate', null)) && 
        isValidEmployee(incoming()) &&
        incoming().get('governorate', null) == existing().get('governorate', null)
      ) || (
        isSignedIn() &&
        incoming().get('email', '') == request.auth.token.email &&
        incoming().get('national_id', '') == employeeId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone_number', 'details', 'academic_email', 'governorate', 'work_place_id'])
      );
      
      allow delete: if isAdmin();
    }

    match /work_units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /appraisals/{appraisalId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /update_requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
  }
}

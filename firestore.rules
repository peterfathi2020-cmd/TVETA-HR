rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Master Admin Override
    // ===============================================================
    match /{document=**} {
      allow read, write: if request.auth != null && 
        (request.auth.token.email == "peterfathi2020@gmail.com" || 
         request.auth.token.email == "admin.sys@academy.edu.eg");
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailOwner(email) {
      return isAuthenticated() && request.auth.token.email == email;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          request.auth.token.email == "peterfathi2020@gmail.com" ||
          request.auth.token.email == "admin.sys@academy.edu.eg" ||
          (
            "email" in request.auth.token &&
            exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
            get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'ACAD_ADMIN'
          )
        );
    }

    function isManager() {
      return isAdmin() || (
        isAuthenticated() && 
        "email" in request.auth.token &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'EDU_MANAGER'
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Users collection (Document ID is the user's email)
    match /users/{email} {
      allow read, write: if isAdmin() || isEmailOwner(email);
      allow delete: if isAdmin();
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create: if isManager() || (isAuthenticated() && request.resource.data.email == request.auth.token.email);
      allow update: if isManager() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow delete: if isManager();
    }

    // Work Units collection
    match /work_units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Audit Logs (Read only for admins, write for authenticated users to log their actions)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Appraisals
    match /appraisals/{appraisalId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.employeeId == request.auth.uid || 
        resource.data.managerId == request.auth.uid
      );
      allow create: if isManager();
      allow update: if isManager() && resource.data.managerId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // HELPERS
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.uid == "dL6527fx8fdiKXmVDPJVZ9UyCJg1" ||
        request.auth.uid == "cecjjnpTEeSxzv3BGpAnCkzgZlJ3" ||
        request.auth.uid == "0orr3a8eNwV4RSZz4IBEyxVSfPl2" ||
        request.auth.uid == "TBTTLtt9Tng0ct22gTtiDleYjWD2" ||
        (
          "email" in request.auth.token &&
          (
            request.auth.token.email == "peterfathi2020@gmail.com" ||
            request.auth.token.email == "admin.sys@academy.edu.eg" ||
            request.auth.token.email == "tveta.hr.2026@gmail.com" ||
            request.auth.token.email == "tveta2026@gmail.com"
          )
        )
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return isMasterAdmin() || (
        isSignedIn() && 
        "email" in request.auth.token &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
        getUserData().role == 'ACAD_ADMIN'
      );
    }

    function isManager() {
      return isAdmin() || (
        isSignedIn() && 
        "email" in request.auth.token &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
        getUserData().role == 'EDU_MANAGER'
      );
    }

    function getUserGovernorate() {
       return exists(/databases/$(database)/documents/users/$(request.auth.token.email)) ? 
              getUserData().governorate : null;
    }

    function isGovernorateManager(gov) {
      return isMasterAdmin() || (
        isManager() && getUserGovernorate() == gov
      );
    }

    // ===============================================================
    // VALIDATION HELPERS
    // ===============================================================

    function isValidEmployee(data) {
      return data.keys().hasAll(['national_id', 'full_name_ar', 'email', 'work_place_id', 'employee_type']) &&
             data.national_id is string && data.national_id.size() == 14 &&
             data.full_name_ar is string && data.full_name_ar.size() >= 3 && data.full_name_ar.size() <= 200 &&
             data.email is string && data.email.size() <= 100 &&
             data.work_place_id is int &&
             data.employee_type in ['TEACHER', 'ADMIN', 'TRAINER', 'TECHNICIAN'];
    }

    // ===============================================================
    // RULES
    // ===============================================================

    // Users collection
    match /users/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow create: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow update: if isSignedIn() && (
        (request.auth.token.email == email && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'governorate'])) ||
        isAdmin()
      );
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() || 
        isAdmin() || 
        isGovernorateManager(resource.data.governorate) || 
        resource.data.email == request.auth.token.email ||
        resource.data.national_id == getUserData().national_id
      );
      
      allow create: if isAdmin() || (isManager() && isValidEmployee(incoming()) && incoming().governorate == getUserGovernorate());
      
      allow update: if isAdmin() || (
        isGovernorateManager(existing().governorate) && 
        isValidEmployee(incoming()) &&
        incoming().governorate == existing().governorate // Manager cannot change governorate
      );
      
      allow delete: if isAdmin();
    }

    // Work Units collection
    match /work_units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Appraisals collection
    match /appraisals/{appraisalId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        isGovernorateManager(get(/databases/$(database)/documents/employees/$(resource.data.employeeId)).data.governorate) ||
        resource.data.employeeId == getUserData().national_id
      );
      
      allow create, update: if isGovernorateManager(get(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.governorate);
      allow delete: if isAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
  }
}
